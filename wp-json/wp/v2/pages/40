from interrupting scroll on mobile *\/\n    touch-action: pan-y;\n    -webkit-overflow-scrolling: touch;\n  }\n  \n  .logo-carousel::before,\n  .logo-carousel::after {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    height: 100%;\n    width: 150px;\n    z-index: 2;\n    pointer-events: none;\n  }\n  \n  .logo-carousel::before {\n    left: 0;\n    background: linear-gradient(to right, white 10%, rgba(255, 255, 255, 0));\n  }\n  \n  .logo-carousel::after {\n    right: 0;\n    background: linear-gradient(to left, white 10%, rgba(255, 255, 255, 0));\n  }\n  \n  .logo-track {\n    display: flex;\n    align-items: center;\n    height: 180px;\n    will-change: transform; \/* Optimize for animation *\/\n    \/* Help with smoother animations *\/\n    transform: translateZ(0);\n    -webkit-transform: translateZ(0);\n    backface-visibility: hidden;\n    -webkit-backface-visibility: hidden;\n    perspective: 1000px;\n    -webkit-perspective: 1000px;\n  }\n  \n  .logo-item {\n    flex: 0 0 auto;\n    padding: 0 30px;\n    transition: transform 0.3s ease;\n  }\n  \n  \/* Only apply hover effects on non-touch devices *\/\n  @media (hover: hover) {\n    .logo-item:hover {\n      transform: scale(1.15);\n    }\n    \n    .logo-item:hover img {\n      filter: grayscale(0%);\n    }\n  }\n  \n  .logo-item a {\n    display: block;\n    height: 100%;\n  }\n  \n  .logo-item img {\n    height: 150px;\n    width: auto;\n    max-width: 200px;\n    object-fit: contain;\n    filter: grayscale(20%);\n    transition: filter 0.3s ease;\n    \/* Prevent image dragging *\/\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-user-drag: none;\n  }\n<\/style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    const logos = [\n       { \n        src: \"https:\/\/paletplein.nl\/wp-content\/uploads\/2025\/05\/Trekpleister-logo-scaled.avif\", \n        href: \"\/trekpleister\",\n        alt: \"Trekpleister\"\n      },\n      { \n        src: \"h