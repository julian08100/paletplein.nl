kys\",\n        alt: \"Kokky's\"\n      },\n      { \n        src: \"https:\/\/paletplein.nl\/wp-content\/uploads\/2025\/05\/Philipsen-Specialiteiten-logo.webp\", \n        href: \"\/philipsen-specialiteiten\",\n        alt: \"Philipsen Specialiteiten\"\n      },\n      { \n        src: \"https:\/\/paletplein.nl\/wp-content\/uploads\/2025\/05\/logo_tvdk_retina.png\", \n        href: \"\/rijwielhandel-ton-van-de-klundert\/\",\n        alt: \"Ton van de Klundert\"\n      },\n      { \n        src: \"https:\/\/paletplein.nl\/wp-content\/uploads\/2025\/05\/tons-salon-logo-zwart.png\", \n        href: \"\/tons-salon\/\",\n        alt: \"T'Ons Salon\"\n      },\n      { \n        src: \"https:\/\/paletplein.nl\/wp-content\/uploads\/2025\/05\/Thelmas-Toko-logo.png\", \n        href: \"\/thelmas-toko\",\n        alt: \"Thelma's Toko\"\n      },\n      { \n        src: \"https:\/\/paletplein.nl\/wp-content\/uploads\/2025\/06\/Broodje-Palet-Meer.jpg\", \n        href: \"\/broodje-palet-meer\",\n        alt: \"Broodje Palet & Meer\"\n      },\n      { \n        src: \"https:\/\/paletplein.nl\/wp-content\/uploads\/2025\/06\/BudoShop-Teejoos-logo.webp\", \n        href: \"\/budoshop-teejoos\",\n        alt: \"Budoshop TeeJoos\"\n      }\n    ];\n    \n    const carousel = document.querySelector('.logo-carousel');\n    const logoTrack = document.querySelector('.logo-track');\n    let animationId;\n    let position = 0;\n    let lastTimestamp = 0;\n    const speed = 50; \/\/ pixels per second\n    let isInitialized = false;\n    let isPaused = false;\n    let isScrolling = false;\n    let scrollTimeout;\n    \n    \/\/ Check if device has hover capability (non-touch device)\n    const hasHoverSupport = window.matchMedia('(hover: hover)').matches;\n    \n    function initializeLogos() {\n      if (isInitialized) return;\n      \n      \/\/ Clear existing content\n      logoTrack.innerHTML = '';\n      \n      \/\/ Add two complete sets for seamless looping\n      logos.forEach(createLogoItem);\n      logos.forEach(createLogoItem);\n      \n      isInitialized = true;\n      \n      \/\/ Start animation\n      startAnimation();\n    }\n    \n    function createLogoItem(logo) {\n      const logoItem = document.createElement('div');\n      logoItem.className = 'logo-item';\n      \n      const link = document.createElement('a');\n      link.href = logo.href;\n      \n      const img = document.createElement('img');\n      img.src = logo.src;\n      img.alt = logo.alt;\n      img.loading = \"lazy\"; \/\/ Add lazy loading for better performance\n      \n      link.appendChild(img);\n      logoItem.appendChild(link);\n      logoTrack.appendChild(logoItem);\n      \n      return logoItem;\n    }\n    \n    function startAnimation() {\n      if (animationId) {\n        cancelAnimationFrame(animationId);\n      }\n      \n      lastTimestamp = performance.now();\n      animationId = requestAnimationFrame(animate);\n      isPaused = false;\n    }\n    \n    function stopAnimation() {\n      if (animationId) {\n        cancelAnimationFrame(animationId);\n        animationId = null;\n      }\n      isPaused = true;\n    }\n    \n    function animate(timestamp) {\n      if (!lastTimestamp) lastTimestamp = timestamp;\n      \n      \/\/ Limit maximum delta time to prevent jumps after tab inactivity\n      const deltaTime = Math.min((timestamp - lastTimestamp) \/ 1000, 0.1);\n      lastTimestamp = timestamp;\n      \n      \/\/ Skip animation if page is not visible or scrolling on mobile\n      if (document.hidden || (isScrolling && !hasHoverSupport)) {\n        animationId = requestAnimationFrame(animate);\n        return;\n      }\n      \n      const trackWidth = logoTrack.scrollWidth \/ 2;\n      position -= speed * deltaTime;\n      \n      \/\/ Reset position when reaching halfway point for seamless loop\n      if (position <= -trackWidth) {\n        position = position + trackWidth;\n      }\n      \n      logoTrack.style.transform = `translateX(${position}px)`;\n      animationId = requestAnimationFrame(animate);\n    }\n    \n    \/\/ Only add hover events on devices with cursor support\n    if (hasHoverSupport) {\n      \/\/ Pause on hover (entire carousel)\n      carousel.addEventListener('mouseenter', () => {\n        stopAnimation();\n      });\n      \n      \/\/ Resume when leaving\n      carousel.addEventListener('mouseleave', () => {\n        startAnimation();\n      });\n    }\n    \n    \/\/ Handle scroll events on mobile to prevent jittering\n    if (!hasHoverSupport) {\n      window.addEventListener('scroll', () => {\n        isScrolling = true;\n        \n        \/\/ Clear the previous timeout\n        clearTimeout(scrollTimeout);\n        \n        \/\/ Set a timeout to run after scrolling ends\n        scrollTimeout = setTimeout(() => {\n          isScrolling = false;\n        }, 200);\n      }, { passive: true });\n    }\n    \n    \/\/ Handle visibility change to prevent jumps when tab is inactive\n    document.addEventListener('visibilitychange', () => {\n      if (document.hidden) {\n        stopAnimation();\n      } else if (!isPaused) {\n        startAnimation();\n      }\n    });\n    \n    \/\/ Initialize only when the element is in viewport\n    const observer = new IntersectionObserver((entries) => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          initializeLogos();\n          observer.disconnect();\n        }\n      });\n    });\n    \n    observer.observe(carousel);\n    \n    \/\/ Handle window resize more efficiently\n    let resizeTimeout;\n    window.addEventListener('resize', function() {\n      clearTimeout(resizeTimeout);\n      resizeTimeout = setTimeout(() => {\n        \/\/ Only reset completely if we need to (width changed significantly)\n        const currentWidth = window.innerWidth;\n        if (!window.lastWidth || Math.abs(currentWidth - window.lastWidth) > 100) {\n          stopAnimation();\n          isInitialized = false;\n          position = 0;\n          logoTrack.innerHTML = '';\n          initializeLogos();\n          window.lastWidth = currentWidth;\n        }\n      }, 250);\n    }, { passive: true });\n  });\n<\/script>\n<\/div>\n\n\n<div class=\"n2_clear\"><ss3-force-full-width data-overflow-x=\"body\" data-horizontal-selector=\"body\"><div class=\"n2-section-smartslider fitvidsignore  n2_clear\" data-ssid=\"2\" tabindex=\"0\" role=\"region\" aria-label=\"Slider\"><div id=\"n2-ss-2-align\" class=\"n2-ss-align\"><div class=\"n2-padding\"><div id=\"n2-ss-2\" data-creator=\"Smart Slider 3\" data-responsive=\"fullwidth\" class=\"n2-ss-slider n2-ow n2-has-hover n2notransition  \">\n\n\n\n<div class=\"n2-ss-slider-wrapper-inside\">\n        <div class=\"n2-ss-slider-1 n2_ss__touch_element n2-ow\">\n            <div class=\"n2-ss-slider-2 n2-ow\">\n                                                <div class=\"n2-ss-slider-3 n2-ow\">\n\n                    <div class=\"n2-ss-slide-backgrounds n2-ow-all\"><div class=\"n2-ss-slide-background\" data-public-id=\"1\" data-mode=\"fill\"><div class=\"n2-ss-slide-background-image\" data-blur=\"0\" data-opacity=\"100\" data-x=\"50\" data-y=\"50\" data-alt=\"\" data-title=\"\"><picture class=\"skip-lazy\" data-skip-lazy=\"1\"><img decoding=\"async\" src=\"\/\/paletplein.nl\/wp-content\/uploads\/slider\/cache\/cfc9777cefda30f705464f1c695857bc\/Paletplein-1-scaled.jpg\" alt=\"\" title=\"\" loading=\"lazy\" class=\"skip-lazy\" data-skip-lazy=\"1\"><\/picture><\/div><div data-color=\"RGBA(255,255,255,0)\" style=\"background-color: RGBA(255,255,255,0);\" class=\"n2-ss-slide-background-color\"><\/div><\/div><div class=\"n2-ss-slide-background\" data-public-id=\"2\" data-mode=\"fill\"><div class=\"n2-ss-slide-background-image\" data-blur=\"0\" data-opacity=\"100\" data-x=\"50\" data-y=\"71\" data-alt=\"\" data-title=\"\" style=\"--ss-o-pos-y:71%\"><picture class=\"skip-lazy\" data-skip-lazy=\"1\"><img decoding=\"async\" src=\"\/\/paletplein.nl\/wp-content\/